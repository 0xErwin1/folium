<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Folium"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme">
        <!--
            Lets a release build be captured by `adb shell perfetto` without making it debuggable:
            a debuggable release would defeat the point of profiling the shipped optimization
            level, and without this a release build cannot be traced by the shell user at all.
        -->
        <profileable android:shell="true" tools:targetApi="29" />
        <activity
            android:name=".FoliumActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <!--
                Handled here so a rotation or a window resize re-lays out the open reader in place
                instead of tearing down and reopening its document session. uiMode, density, locale,
                fontScale and layoutDirection are deliberately left out: the theme and resources
                depend on those, and nothing in the reader has been checked against them changing
                without a recreation.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
            </intent-filter>
        </activity>
        <activity android:name=".HarnessActivity" android:exported="false" />
    </application>
</manifest>
